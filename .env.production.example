# ═══════════════════════════════════════════════
# Variables de PRODUCCIÓN (VPS).
# Copiar como .env.production en el servidor y rellenar.
#   cp .env.production.example .env.production && nano .env.production
#
# ⚠ NUNCA subir .env.production a git (está en .gitignore).
# Uso: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# ═══════════════════════════════════════════════

# ── Dominio y certificado ──
# El dominio debe apuntar por DNS (registro A) a la IP del VPS ANTES de
# levantar el stack: Caddy pide el certificado en el arranque.
DOMAIN=r4ce.app
ACME_EMAIL=tu@email.com

# ── Base de datos ──
DB_USER=r4ce_prod
# Generar: openssl rand -base64 32
DB_PASSWORD=CAMBIAR_password_larga_aleatoria
DB_NAME=r4ce_prod

# ── Secretos ──
# Generar cada uno con: openssl rand -hex 64
JWT_SECRET=CAMBIAR_hex_64_bytes
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES_DAYS=30

# ⚠⚠ CHAT_MASTER_KEY: deriva la clave de cifrado de CADA grupo de chat.
# Cambiarla más adelante deja ILEGIBLE todo el histórico de mensajes.
# Fíjala AHORA, antes de tener usuarios reales, y guárdala en un gestor
# de contraseñas + copia de seguridad offline.
CHAT_MASTER_KEY=CAMBIAR_hex_64_bytes_y_NO_TOCAR_NUNCA_MAS

# ── Roles y legales ──
# Usuarios que reciben rol admin al arrancar (separados por comas)
ADMIN_USERNAMES=sanchez
TOS_VERSION=2026-07-11
# En producción sí exigimos email verificado para publicar contenido público
REQUIRE_EMAIL_VERIFICATION=true

# ── CORS de la app nativa ──
# Capacitor: Android usa https://localhost e iOS capacitor://localhost
# (ya están permitidos por defecto en el código; añade aquí solo extras)
MOBILE_URL=

# ── Almacenamiento: Cloudflare R2 ──
# Crear bucket en dash.cloudflare.com > R2, con acceso público
# (dominio propio tipo media.tudominio.com o el r2.dev del bucket).
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=r4ce-media
R2_PUBLIC_URL=https://media.tudominio.com

# ── Email (verificación de cuentas) ──
# Servicios con plan gratuito: Resend, Brevo, Mailgun.
# Sin SMTP el enlace de verificación se escribe en el log del backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="R4ce <no-reply@tudominio.com>"

# ── Push nativo (opcional, ver docs/CAPACITOR.md) ──
# JSON del service account de Firebase EN UNA SOLA LÍNEA
FIREBASE_SERVICE_ACCOUNT=
